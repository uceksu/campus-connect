generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hostel {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("Boys") // "Boys" or "Girls"
  image       String
  distance    String
  rating      Float
  phone       String
  maps        String
  price       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hospital {
  id               String   @id @default(cuid())
  name             String
  image            String
  address          String
  phone            String
  emergencyContact String
  maps             String
  description      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(ADMIN)
  permissions   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeaShop {
  id          String   @id @default(cuid())
  name        String
  image       String
  address     String
  phone       String
  maps        String
  description String
  rating      Float
  price       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  image       String
  address     String
  phone       String
  maps        String
  description String
  rating      Float
  price       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcademicNote {
  id          String   @id @default(cuid())
  title       String
  subject     String
  semester    String
  branch      String   @default("General")
  scheme      String   @default("2019")
  type        String   @default("Note") // "Note" or "Question Paper"
  module      String   @default("Module 1") // "Module 1", "Module 2", "Module 3", "Module 4"
  description String
  fileUrl     String
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Club {
  id              String   @id @default(cuid())
  name            String
  image           String
  description     String
  category        String
  contactEmail    String
  contactPhone    String
  meetingSchedule String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NearbyPlace {
  id          String   @id @default(cuid())
  name        String
  image       String
  category    String
  address     String
  phone       String
  maps        String
  description String
  rating      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String
  category    String
  image       String?
  isImportant Boolean   @default(false)
  status      String    @default("PUBLISHED") // "DRAFT", "SCHEDULED", "PUBLISHED"
  publishAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Scholarship {
  id          String   @id @default(cuid())
  name        String
  provider    String
  amount      String
  deadline    String
  eligibility String
  description String
  applyLink   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model CommitteeMember {
  id           String   @id @default(cuid())
  name         String
  role         String
  organization String // "KSU" or "Priyadarshini"
  image        String
  whatsapp     String
  instagram    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AcademicSubject {
  id        String   @id @default(cuid())
  name      String
  branch    String
  semester    String
  scheme      String   @default("2019")
  syllabusUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Developer {
  id          String   @id @default(cuid())
  name        String
  role        String
  image       String
  whatsapp    String
  instagram   String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  name        String
  shortName   String
  description String
  faculty     Faculty[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Faculty {
  id             String     @id @default(cuid())
  name           String
  designation    String
  specialization String?
  email          String?
  phone          String?
  isHOD          Boolean    @default(false)
  image          String?
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  target    String
  details   String?
  createdAt DateTime @default(now())
}

model NoteRequest {
  id          String   @id @default(cuid())
  subject     String
  semester    String
  branch      String
  studentName String
  message     String?
  status      String   @default("PENDING") // "PENDING", "RESOLVED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KsuMember {
  id         String   @id @default(cuid())
  memberId   String   @unique
  name       String
  email      String   @default("")
  department String
  year       String?
  location   String?
  photoUrl   String?
  joinedAt   DateTime @default(now())
}
